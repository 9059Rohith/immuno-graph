NODE_ENV=production

# Vercel build-time configuration. Set this to the public Render API URL plus /api/v1.
VITE_API_BASE_URL=

# Render API. CORS_ORIGINS is a comma-separated list of exact Vercel origins.
API_HOST=0.0.0.0
API_PORT=3000
API_LOG_LEVEL=info
CORS_ORIGINS=
DATABASE_URL=file:/data/immunograph.db
ARTIFACT_ROOT=/data/artifacts
MCP_SERVER_URL=
MCP_REQUEST_TIMEOUT_MS=180000

# Render MCP service.
HOST=0.0.0.0
PORT=3001
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_TRANSPORT_TYPE=http

# Safe public-demo defaults. The judged workflow is deterministic and fixture-only.
DEMO_MODE=true
LLM_ENABLED=false
IEDB_LIVE_ENABLED=false
IEDB_POPULATION_COVERAGE_ENABLED=false
MHCFLURRY_ENABLED=false

# Non-secret reproducibility metadata.
APPLICATION_VERSION=0.1.0
SPECIFICATION_VERSION=0.8.0
# COMMIT_SHA=
# BUILT_AT=

# Optional production docking provider. Leave unset until a real provider is configured.
# DOCKING_PROVIDER_URL=
# DOCKING_PROVIDER_TOKEN=
# DOCKING_ENGINE_NAME=
# DOCKING_ENGINE_VERSION=
